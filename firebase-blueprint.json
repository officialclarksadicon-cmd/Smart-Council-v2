{
  "entities": {
    "StudentUser": {
      "title": "StudentUser",
      "description": "Normal SLAC student user authenticated via Google Sign-In, stored separately from council officers.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the student.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Full display name of the student.",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google email address of the student.",
          "minLength": 3,
          "maxLength": 160
        },
        "yearCourse": {
          "type": "string",
          "description": "Year and degree program of the student.",
          "minLength": 1,
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "Optional Google profile avatar URL.",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "name", "email", "yearCourse", "createdAt", "updatedAt"]
    },
    "CouncilAccount": {
      "title": "CouncilAccount",
      "description": "Provisioned SSC Officer or Web Admin account (no plaintext passcodes; roles enforced via Firebase Auth Custom Claims and councilAccounts UID mapping).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Account identifier (matches Firebase Auth UID).",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Registered email for the council officer or admin.",
          "minLength": 3,
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "description": "Full name of the council officer or admin.",
          "minLength": 1,
          "maxLength": 120
        },
        "position": {
          "type": "string",
          "description": "Official SLAC SSC position title.",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "description": "Access tier (admin or official).",
          "enum": ["admin", "official"]
        },
        "authUid": {
          "type": "string",
          "description": "Optional linked Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByEmail": {
          "type": "string",
          "description": "Admin email that provisioned this account.",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "email",
        "name",
        "position",
        "role",
        "createdByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "CouncilOfficer": {
      "title": "CouncilOfficer",
      "description": "Public SLAC SSC Council Officer directory record pushed when the Web Admin or an official updates officer rosters.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique officer slot or record ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "term": {
          "type": "string",
          "description": "Academic term label (e.g., 2025–2026).",
          "minLength": 4,
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "description": "Officer full name.",
          "minLength": 0,
          "maxLength": 120
        },
        "position": {
          "type": "string",
          "description": "Official SLAC SSC position.",
          "minLength": 1,
          "maxLength": 80
        },
        "committee": {
          "type": "string",
          "description": "Council committee division.",
          "enum": [
            "Executive Board",
            "Year Level Representatives",
            "Information",
            "Documentary",
            "Technical"
          ]
        },
        "image": {
          "type": "string",
          "description": "ImageKit cloud portrait URL.",
          "maxLength": 500
        },
        "optional": {
          "type": "boolean",
          "description": "Whether this position slot is optional (Asst. Secretary)."
        },
        "accountId": {
          "type": "string",
          "description": "Optional linked CouncilAccount ID.",
          "maxLength": 128
        },
        "visibility": {
          "type": "string",
          "description": "Public visibility marker for secure list queries.",
          "enum": ["public"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "term",
        "name",
        "position",
        "committee",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Official SLAC SSC memo and campus announcement streamed in real time to all visitors.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique announcement ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Announcement headline.",
          "minLength": 1,
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "description": "Display date label.",
          "minLength": 1,
          "maxLength": 60
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Sortable publication timestamp."
        },
        "category": {
          "type": "string",
          "description": "Announcement category filter tag.",
          "minLength": 1,
          "maxLength": 80
        },
        "summary": {
          "type": "string",
          "description": "Full announcement summary body.",
          "minLength": 1,
          "maxLength": 2000
        },
        "issuedBy": {
          "type": "string",
          "description": "Issuing officer or council office.",
          "minLength": 1,
          "maxLength": 160
        },
        "image": {
          "type": "string",
          "description": "Optional ImageKit cloud banner URL.",
          "maxLength": 500
        },
        "visibility": {
          "type": "string",
          "description": "Public visibility marker for secure list queries.",
          "enum": ["public"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "title",
        "date",
        "category",
        "summary",
        "issuedBy",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "PortalEvent": {
      "title": "PortalEvent",
      "description": "Upcoming SLAC SSC campus activity and gallery item streamed in real time to all visitors.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique event ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Event title.",
          "minLength": 1,
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "description": "Event date string.",
          "minLength": 1,
          "maxLength": 80
        },
        "startsAt": {
          "type": "string",
          "format": "date-time",
          "description": "Sortable event start timestamp."
        },
        "time": {
          "type": "string",
          "description": "Event time window.",
          "minLength": 1,
          "maxLength": 80
        },
        "location": {
          "type": "string",
          "description": "Campus venue.",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "description": "Event filter category.",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "description": "Event description.",
          "minLength": 1,
          "maxLength": 2000
        },
        "image": {
          "type": "string",
          "description": "ImageKit cloud event cover photo URL.",
          "minLength": 1,
          "maxLength": 500
        },
        "imageAlt": {
          "type": "string",
          "description": "Accessible alt text for event cover image.",
          "minLength": 1,
          "maxLength": 240
        },
        "visibility": {
          "type": "string",
          "description": "Public visibility marker for secure list queries.",
          "enum": ["public"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "title",
        "date",
        "time",
        "location",
        "category",
        "description",
        "image",
        "imageAlt",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "ForumThreadDoc": {
      "title": "ForumThreadDoc",
      "description": "Live student forum discussion thread with authorUid ownership.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique thread ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "author": {
          "type": "string",
          "description": "Verified student or officer display name.",
          "minLength": 1,
          "maxLength": 120
        },
        "authorUid": {
          "type": "string",
          "description": "Firebase Auth UID of the thread author.",
          "minLength": 1,
          "maxLength": 128
        },
        "yearLevel": {
          "type": "string",
          "description": "Author year/program or council position.",
          "minLength": 1,
          "maxLength": 100
        },
        "postedAt": {
          "type": "string",
          "description": "Human-readable posted timestamp.",
          "minLength": 1,
          "maxLength": 60
        },
        "topic": {
          "type": "string",
          "description": "Forum topic category.",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "description": "Discussion title.",
          "minLength": 1,
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "description": "Discussion body text.",
          "minLength": 1,
          "maxLength": 3000
        },
        "supportCount": {
          "type": "number",
          "description": "Total student support count."
        },
        "replies": {
          "type": "array",
          "description": "Bounded list of reply objects."
        },
        "visibility": {
          "type": "string",
          "description": "Public visibility marker for secure list queries.",
          "enum": ["public"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "author",
        "yearLevel",
        "postedAt",
        "topic",
        "title",
        "body",
        "supportCount",
        "replies",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "ForumReplyDoc": {
      "title": "ForumReplyDoc",
      "description": "Forum reply stored in /forumThreads/{threadId}/replies/{replyId}.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "yearLevel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "time": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "threadId",
        "author",
        "authorUid",
        "yearLevel",
        "time",
        "message",
        "createdAt"
      ]
    },
    "ForumSupportDoc": {
      "title": "ForumSupportDoc",
      "description": "Per-user forum support record stored at /forumThreads/{threadId}/supports/{userId}.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "threadId", "createdAt"]
    },
    "PortalSettings": {
      "title": "PortalSettings",
      "description": "Synchronized category filter tags and branding assets for all portal visitors.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Settings document ID (e.g., config).",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "announcementFilters": {
          "type": "array",
          "description": "Bounded list of announcement filter tags."
        },
        "eventFilters": {
          "type": "array",
          "description": "Bounded list of event filter tags."
        },
        "forumFilters": {
          "type": "array",
          "description": "Bounded list of forum topic filter tags."
        },
        "aiAutoSync": {
          "type": "boolean",
          "description": "Whether AI filter sync runs automatically on new entries."
        },
        "visibility": {
          "type": "string",
          "description": "Public visibility marker for secure queries.",
          "enum": ["public"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "announcementFilters",
        "eventFilters",
        "forumFilters",
        "aiAutoSync",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "FaqDoc": {
      "title": "FaqDoc",
      "description": "Frequently Asked Question entry editable by SSC Officials and Web Admins and streamed live to all portal visitors.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique FAQ item ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "description": "FAQ topic category label.",
          "minLength": 1,
          "maxLength": 80
        },
        "question": {
          "type": "string",
          "description": "Student question headline.",
          "minLength": 1,
          "maxLength": 300
        },
        "answer": {
          "type": "string",
          "description": "Official council answer.",
          "minLength": 1,
          "maxLength": 2000
        },
        "order": {
          "type": "number",
          "description": "Display sort order."
        },
        "visibility": {
          "type": "string",
          "description": "Public visibility marker for secure queries.",
          "enum": ["public"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "category",
        "question",
        "answer",
        "order",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "CouncilTask": {
      "title": "CouncilTask",
      "description": "SSC Suite task item assigned to a specific SSC officer.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique task ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Task title.",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "description": "Task details and instructions.",
          "maxLength": 2000
        },
        "assignedToUid": {
          "type": "string",
          "description": "Firebase Auth UID / Council Account ID of the assigned officer.",
          "minLength": 1,
          "maxLength": 128
        },
        "assignedToName": {
          "type": "string",
          "description": "Full name of the assigned Council Officer.",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "type": "string",
          "description": "Task completion status.",
          "enum": ["pending", "completed"]
        },
        "createdBy": {
          "type": "string",
          "description": "UID or email of the officer who created the task.",
          "minLength": 1,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Completion timestamp when marked completed by the assignee."
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "assignedToUid",
        "assignedToName",
        "status",
        "createdBy",
        "createdAt"
      ]
    },
    "SiteVisits": {
      "title": "SiteVisits",
      "description": "Real-time total website visits counter stored at /siteStats/visits.",
      "type": "object",
      "properties": {
        "visits": {
          "type": "number",
          "description": "Cumulative website visits incremented atomically by +1."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["visits"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "StudentUser",
      "description": "Normal student users authenticated with Google Sign-In (isolated from council officers)."
    },
    "/councilAccounts/{accountId}": {
      "schema": "CouncilAccount",
      "description": "Provisioned SSC Officer and Web Admin accounts readable strictly by officials/admins."
    },
    "/councilOfficers/{officerId}": {
      "schema": "CouncilOfficer",
      "description": "Public council officers collection populated and streamed live across all users."
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Official SLAC SSC announcements streamed live to guests, students, and officers."
    },
    "/events/{eventId}": {
      "schema": "PortalEvent",
      "description": "Upcoming SLAC SSC campus events streamed live to guests, students, and officers."
    },
    "/forumThreads/{threadId}": {
      "schema": "ForumThreadDoc",
      "description": "Live student forum discussions readable by all visitors and writable by signed-in students and officers."
    },
    "/forumThreads/{threadId}/replies/{replyId}": {
      "schema": "ForumReplyDoc",
      "description": "Subcollection of replies for a forum thread."
    },
    "/forumThreads/{threadId}/supports/{userId}": {
      "schema": "ForumSupportDoc",
      "description": "Per-UID support tracking documents for a forum thread."
    },
    "/portalSettings/{settingId}": {
      "schema": "PortalSettings",
      "description": "Synchronized portal filter categories and branding assets (customLogoUrl, aboutSlacImage)."
    },
    "/faqs/{faqId}": {
      "schema": "FaqDoc",
      "description": "Editable Frequently Asked Questions streamed live to guests, students, and officers."
    },
    "/tasks/{taskId}": {
      "schema": "CouncilTask",
      "description": "Assigned tasks linked to Council Accounts, completable strictly by the assigned officer."
    },
    "/siteStats/{statId}": {
      "schema": "SiteVisits",
      "description": "Real-time total website visit counter (/siteStats/visits)."
    }
  }
}
