{
  "entities": {
    "StudentUser": {
      "title": "StudentUser",
      "description": "Normal SLAC student user authenticated via Google Sign-In, stored separately from council officers.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the student.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Full display name of the student.",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google email address of the student.",
          "minLength": 3,
          "maxLength": 160
        },
        "yearCourse": {
          "type": "string",
          "description": "Year and degree program of the student.",
          "minLength": 1,
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "Optional Google profile avatar URL.",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "name", "email", "yearCourse", "createdAt", "updatedAt"]
    },
    "OfficialUser": {
      "title": "OfficialUser",
      "description": "Verified Firebase Auth UID registry for provisioned SSC Officials and Web Admins.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the official.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "accountId": {
          "type": "string",
          "description": "Corresponding CouncilAccount document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Official full name.",
          "minLength": 1,
          "maxLength": 120
        },
        "position": {
          "type": "string",
          "description": "Official SLAC SSC position title.",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "description": "Access role (admin or official).",
          "enum": ["admin", "official"]
        },
        "visibility": {
          "type": "string",
          "description": "Visibility marker for admin queries.",
          "enum": ["public"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "accountId",
        "name",
        "position",
        "role",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "CouncilAccount": {
      "title": "CouncilAccount",
      "description": "Provisioned SSC Officer or Web Admin account managed exclusively by official.clarksadicon@gmail.com.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Account identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Registered email for the council officer or admin.",
          "minLength": 3,
          "maxLength": 160
        },
        "passcode": {
          "type": "string",
          "description": "Assigned officer login passcode.",
          "minLength": 4,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "Full name of the council officer or admin.",
          "minLength": 1,
          "maxLength": 120
        },
        "position": {
          "type": "string",
          "description": "Official SLAC SSC position title.",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "description": "Access tier (admin or official).",
          "enum": ["admin", "official"]
        },
        "authUid": {
          "type": "string",
          "description": "Optional linked Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByEmail": {
          "type": "string",
          "description": "Admin email that provisioned this account.",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "email",
        "passcode",
        "name",
        "position",
        "role",
        "createdByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "CouncilOfficer": {
      "title": "CouncilOfficer",
      "description": "Public SLAC SSC Council Officer directory record pushed when the Web Admin or an official updates officer rosters, stored separately from normal student users.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique officer slot or record ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "term": {
          "type": "string",
          "description": "Academic term label (e.g., 2025–2026).",
          "minLength": 4,
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "description": "Officer full name.",
          "minLength": 0,
          "maxLength": 120
        },
        "position": {
          "type": "string",
          "description": "Official SLAC SSC position.",
          "minLength": 1,
          "maxLength": 80
        },
        "committee": {
          "type": "string",
          "description": "Council committee division.",
          "enum": [
            "Executive Board",
            "Year Level Representatives",
            "Information",
            "Documentary",
            "Technical"
          ]
        },
        "image": {
          "type": "string",
          "description": "ImageKit cloud portrait URL.",
          "maxLength": 500
        },
        "optional": {
          "type": "boolean",
          "description": "Whether this position slot is optional (Asst. Secretary)."
        },
        "accountId": {
          "type": "string",
          "description": "Optional linked CouncilAccount ID.",
          "maxLength": 128
        },
        "visibility": {
          "type": "string",
          "description": "Public visibility marker for secure list queries.",
          "enum": ["public"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "term",
        "name",
        "position",
        "committee",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "Announcement": {
      "title": "Announcement",
