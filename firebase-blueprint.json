          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Announcement headline.",
          "minLength": 1,
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "description": "Display date label.",
          "minLength": 1,
          "maxLength": 60
        },
        "category": {
          "type": "string",
          "description": "Announcement category filter tag.",
          "minLength": 1,
          "maxLength": 80
        },
        "summary": {
          "type": "string",
          "description": "Full announcement summary body.",
          "minLength": 1,
          "maxLength": 2000
        },
        "issuedBy": {
          "type": "string",
          "description": "Issuing officer or council office.",
          "minLength": 1,
          "maxLength": 160
        },
        "image": {
          "type": "string",
          "description": "Optional ImageKit cloud banner URL.",
          "maxLength": 500
        },
        "visibility": {
          "type": "string",
          "description": "Public visibility marker for secure list queries.",
          "enum": ["public"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "title",
        "date",
        "category",
        "summary",
        "issuedBy",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "PortalEvent": {
      "title": "PortalEvent",
      "description": "Upcoming SLAC SSC campus activity and gallery item streamed in real time to all visitors.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique event ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Event title.",
          "minLength": 1,
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "description": "Event date string.",
          "minLength": 1,
          "maxLength": 80
        },
        "time": {
          "type": "string",
          "description": "Event time window.",
          "minLength": 1,
          "maxLength": 80
        },
        "location": {
          "type": "string",
          "description": "Campus venue.",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "description": "Event filter category.",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "description": "Event description.",
          "minLength": 1,
          "maxLength": 2000
        },
        "image": {
          "type": "string",
          "description": "ImageKit cloud event cover photo URL.",
          "minLength": 1,
          "maxLength": 500
        },
        "imageAlt": {
          "type": "string",
          "description": "Accessible alt text for event cover image.",
          "minLength": 1,
