        },
        "visibility": {
          "type": "string",
          "description": "Public visibility marker for secure list queries.",
          "enum": ["public"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "title",
        "date",
        "time",
        "location",
        "category",
        "description",
        "image",
        "imageAlt",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "ForumThreadDoc": {
      "title": "ForumThreadDoc",
      "description": "Live student forum discussion thread and bounded replies list.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique thread ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "author": {
          "type": "string",
          "description": "Verified student or officer display name.",
          "minLength": 1,
          "maxLength": 120
        },
        "yearLevel": {
          "type": "string",
          "description": "Author year/program or council position.",
          "minLength": 1,
          "maxLength": 100
        },
        "postedAt": {
          "type": "string",
          "description": "Human-readable posted timestamp.",
          "minLength": 1,
          "maxLength": 60
        },
        "topic": {
          "type": "string",
          "description": "Forum topic category.",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "description": "Discussion title.",
          "minLength": 1,
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "description": "Discussion body text.",
          "minLength": 1,
          "maxLength": 3000
        },
        "supportCount": {
          "type": "number",
          "description": "Total student support count."
        },
        "replies": {
          "type": "array",
          "description": "Bounded list of up to 100 reply objects."
        },
        "visibility": {
          "type": "string",
          "description": "Public visibility marker for secure list queries.",
          "enum": ["public"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "author",
        "yearLevel",
        "postedAt",
        "topic",
        "title",
        "body",
        "supportCount",
        "replies",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "PortalSettings": {
      "title": "PortalSettings",
      "description": "Synchronized category filter tags and AI filter settings for all portal visitors.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Settings document ID (e.g., config).",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "announcementFilters": {
          "type": "array",
          "description": "Bounded list of announcement filter tags."
        },
        "eventFilters": {
          "type": "array",
          "description": "Bounded list of event filter tags."
        },
        "forumFilters": {
          "type": "array",
          "description": "Bounded list of forum topic filter tags."
        },
        "aiAutoSync": {
          "type": "boolean",
          "description": "Whether AI filter sync runs automatically on new entries."
        },
        "visibility": {
          "type": "string",
          "description": "Public visibility marker for secure queries.",
          "enum": ["public"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "announcementFilters",
        "eventFilters",
        "forumFilters",
        "aiAutoSync",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "FaqDoc": {
      "title": "FaqDoc",
      "description": "Frequently Asked Question entry editable by SSC Officials and Web Admins and streamed live to all portal visitors.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique FAQ item ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "description": "FAQ topic category label.",
          "minLength": 1,
          "maxLength": 80
        },
        "question": {
          "type": "string",
          "description": "Student question headline.",
          "minLength": 1,
          "maxLength": 300
        },
        "answer": {
          "type": "string",
          "description": "Official council answer.",
          "minLength": 1,
          "maxLength": 2000
        },
        "order": {
          "type": "number",
          "description": "Display sort order."
        },
        "visibility": {
          "type": "string",
          "description": "Public visibility marker for secure queries.",
          "enum": ["public"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "category",
        "question",
        "answer",
        "order",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "StudentUser",
      "description": "Normal student users authenticated with Google Sign-In (isolated from council officers)."
    },
    "/officialUsers/{userId}": {
      "schema": "OfficialUser",
      "description": "Verified Firebase Auth UID registry for provisioned SSC Officials and Web Admins."
    },
    "/councilAccounts/{accountId}": {
      "schema": "CouncilAccount",
      "description": "Provisioned SSC Officer and Web Admin accounts managed exclusively by official.clarksadicon@gmail.com."
    },
    "/councilOfficers/{officerId}": {
      "schema": "CouncilOfficer",
      "description": "Council officers collection populated and streamed live across all users."
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Official SLAC SSC announcements streamed live to guests, students, and officers."
    },
    "/events/{eventId}": {
      "schema": "PortalEvent",
      "description": "Upcoming SLAC SSC campus events streamed live to guests, students, and officers."
    },
    "/forumThreads/{threadId}": {
      "schema": "ForumThreadDoc",
      "description": "Live student forum discussions readable by all visitors and writable by signed-in students and officers."
    },
    "/portalSettings/{settingId}": {
      "schema": "PortalSettings",
      "description": "Synchronized portal filter categories for announcements, events, and forum topics."
    },
    "/faqs/{faqId}": {
      "schema": "FaqDoc",
      "description": "Editable Frequently Asked Questions streamed live to guests, students, and officers."
    }
  }
}
