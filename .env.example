# ============================================================================
# SMART COUNCIL — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ============================================================================
# Copy this file to .env for local development.
# NEVER commit .env or real private keys to version control.
# NEVER prefix private keys with VITE_ (which exposes them to the browser).

# 1. Server-Side ImageKit Credentials (used by server.ts / Cloud Functions)
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/slacssc
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here

# 2. Client-Side Public Configuration (safe for browser bundle)
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/slacssc
VITE_APP_CHECK_SITE_KEY=your_recaptcha_v3_or_enterprise_site_key_here

# 3. Optional Runtime Port
PORT=3000
