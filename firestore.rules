rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. GLOBAL AUTHENTICATION & CUSTOM CLAIM ROLE HELPERS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUrl(val, maxLen) {
      return val is string && val.size() <= maxLen &&
        (val.size() == 0 || val.matches('^https?://.*') || val.matches('^/.*') || val.matches('^data:image/.*'));
    }

    // Primary Web Admin check via Firebase Auth Custom Claim (`role == 'admin'`)
    // with safe fallback for the primary admin UID/verified email or verified councilAccounts doc.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('role', '') == 'admin' ||
        request.auth.uid == 'r6KDRrPBerb0KiJ3M5QYpZ0Yjl62' ||
        (
          request.auth.token.email == 'official.clarksadicon@gmail.com' &&
          request.auth.token.email_verified == true
        ) ||
        (
          exists(/databases/$(database)/documents/councilAccounts/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/councilAccounts/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // Verified SSC Official or Web Admin via Custom Claim (`role in ['admin', 'official']`)
    // or verified councilAccounts UID record.
    function isOfficialOrAdmin() {
      return isAdmin() || (
        isSignedIn() && (
          request.auth.token.get('role', '') == 'official' ||
          (
            exists(/databases/$(database)/documents/councilAccounts/$(request.auth.uid)) &&
            (
              get(/databases/$(database)/documents/councilAccounts/$(request.auth.uid)).data.role == 'official' ||
              get(/databases/$(database)/documents/councilAccounts/$(request.auth.uid)).data.role == 'admin'
            )
          )
        )
      );
    }

    function isForumParticipant() {
      return isSignedIn() && (
        isOfficialOrAdmin() ||
        exists(/databases/$(database)/documents/students/$(request.auth.uid))
      );
    }

    // =========================================================================
    // 2. DOCUMENT SCHEMA VALIDATORS
    // =========================================================================

    function isValidStudentUser(data, studentId) {
      return data.keys().hasAll(['uid', 'name', 'email', 'yearCourse', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'yearCourse', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.uid == studentId &&
        data.uid == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.yearCourse is string && data.yearCourse.size() >= 1 && data.yearCourse.size() <= 100 &&
        (!('photoURL' in data) || isValidUrl(data.photoURL, 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Passcodes are never stored on councilAccounts documents.
    function isValidCouncilAccount(data, accountId) {
      return data.keys().hasAll(['id', 'email', 'name', 'position', 'role', 'createdByEmail', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'email', 'name', 'position', 'role', 'authUid', 'createdByEmail', 'createdAt', 'updatedAt']) &&
        !('passcode' in data) &&
        data.id == accountId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.position is string && data.position.size() >= 1 && data.position.size() <= 80 &&
        (data.role == 'admin' || data.role == 'official') &&
        (!('authUid' in data) || (data.authUid is string && data.authUid.size() >= 1 && data.authUid.size() <= 128)) &&
        data.createdByEmail is string && data.createdByEmail.size() >= 3 && data.createdByEmail.size() <= 160 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCouncilOfficer(data, officerId) {
      return data.keys().hasAll(['id', 'term', 'name', 'position', 'committee', 'visibility', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'term', 'name', 'position', 'committee', 'image', 'optional', 'accountId', 'visibility', 'createdAt', 'updatedAt']) &&
        data.id == officerId &&
        data.term is string && data.term.size() >= 4 && data.term.size() <= 32 &&
        data.name is string && data.name.size() >= 0 && data.name.size() <= 120 &&
        data.position is string && data.position.size() >= 1 && data.position.size() <= 80 &&
        (
          data.committee == 'Executive Board' ||
          data.committee == 'Year Level Representatives' ||
          data.committee == 'Information' ||
          data.committee == 'Documentary' ||
          data.committee == 'Technical'
        ) &&
        (!('image' in data) || isValidUrl(data.image, 500)) &&
        (!('optional' in data) || data.optional is bool) &&
        (!('accountId' in data) || (data.accountId is string && data.accountId.size() <= 128)) &&
        data.visibility == 'public' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAnnouncement(data, announcementId) {
      return data.keys().hasAll(['id', 'title', 'date', 'category', 'summary', 'issuedBy', 'visibility', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'title', 'date', 'publishedAt', 'category', 'summary', 'issuedBy', 'image', 'visibility', 'createdAt', 'updatedAt']) &&
        data.id == announcementId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.date is string && data.date.size() >= 1 && data.date.size() <= 60 &&
        (!('publishedAt' in data) || data.publishedAt is timestamp) &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 2000 &&
        data.issuedBy is string && data.issuedBy.size() >= 1 && data.issuedBy.size() <= 160 &&
        (!('image' in data) || isValidUrl(data.image, 500)) &&
        data.visibility == 'public' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPortalEvent(data, eventId) {
      return data.keys().hasAll(['id', 'title', 'date', 'time', 'location', 'category', 'description', 'image', 'imageAlt', 'visibility', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'title', 'date', 'startsAt', 'time', 'location', 'category', 'description', 'image', 'imageAlt', 'visibility', 'createdAt', 'updatedAt']) &&
        data.id == eventId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.date is string && data.date.size() >= 1 && data.date.size() <= 80 &&
        (!('startsAt' in data) || data.startsAt is timestamp) &&
        data.time is string && data.time.size() >= 1 && data.time.size() <= 80 &&
        data.location is string && data.location.size() >= 1 && data.location.size() <= 160 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 2000 &&
        isValidUrl(data.image, 500) && data.image.size() >= 1 &&
        data.imageAlt is string && data.imageAlt.size() >= 1 && data.imageAlt.size() <= 240 &&
        data.visibility == 'public' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidForumThread(data, threadId) {
      return data.keys().hasAll(['id', 'author', 'authorUid', 'yearLevel', 'postedAt', 'topic', 'title', 'body', 'supportCount', 'replies', 'visibility', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'author', 'authorUid', 'yearLevel', 'postedAt', 'topic', 'title', 'body', 'supportCount', 'replies', 'visibility', 'createdAt', 'updatedAt']) &&
        data.id == threadId &&
        data.author is string && data.author.size() >= 1 && data.author.size() <= 120 &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.yearLevel is string && data.yearLevel.size() >= 1 && data.yearLevel.size() <= 100 &&
        data.postedAt is string && data.postedAt.size() >= 1 && data.postedAt.size() <= 60 &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 80 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 3000 &&
        data.supportCount is int && data.supportCount >= 0 && data.supportCount <= 1000000 &&
        data.replies is list && data.replies.size() <= 100 &&
        data.visibility == 'public' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidForumReply(data, replyId, threadId) {
      return data.keys().hasAll(['id', 'threadId', 'author', 'authorUid', 'yearLevel', 'time', 'message', 'createdAt']) &&
        data.keys().hasOnly(['id', 'threadId', 'author', 'authorUid', 'yearLevel', 'time', 'message', 'createdAt']) &&
        data.id == replyId &&
        data.threadId == threadId &&
        data.author is string && data.author.size() >= 1 && data.author.size() <= 120 &&
        data.authorUid == request.auth.uid &&
        data.yearLevel is string && data.yearLevel.size() >= 1 && data.yearLevel.size() <= 100 &&
        data.time is string && data.time.size() >= 1 && data.time.size() <= 60 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 2000 &&
        data.createdAt is timestamp;
    }

    function isValidForumSupport(data, userId, threadId) {
      return data.keys().hasAll(['uid', 'threadId', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'threadId', 'createdAt']) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.threadId == threadId &&
        data.createdAt is timestamp;
    }

    function isValidPortalSettings(data, settingId) {
      return data.keys().hasAll(['id', 'announcementFilters', 'eventFilters', 'forumFilters', 'aiAutoSync', 'visibility', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'announcementFilters', 'eventFilters', 'forumFilters', 'aiAutoSync', 'customLogoUrl', 'aboutSlacImage', 'visibility', 'createdAt', 'updatedAt']) &&
        data.id == settingId &&
        data.announcementFilters is list && data.announcementFilters.size() <= 40 &&
        data.eventFilters is list && data.eventFilters.size() <= 40 &&
        data.forumFilters is list && data.forumFilters.size() <= 40 &&
        data.aiAutoSync is bool &&
        (!('customLogoUrl' in data) || isValidUrl(data.customLogoUrl, 500)) &&
        (!('aboutSlacImage' in data) || isValidUrl(data.aboutSlacImage, 500)) &&
        data.visibility == 'public' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFaqDoc(data, faqId) {
      return data.keys().hasAll(['id', 'category', 'question', 'answer', 'order', 'visibility', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'category', 'question', 'answer', 'order', 'visibility', 'createdAt', 'updatedAt']) &&
        data.id == faqId &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.question is string && data.question.size() >= 1 && data.question.size() <= 300 &&
        data.answer is string && data.answer.size() >= 1 && data.answer.size() <= 2000 &&
        data.order is int && data.order >= 0 && data.order <= 10000 &&
        data.visibility == 'public' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCouncilTask(data, taskId) {
      return data.keys().hasAll(['id', 'title', 'description', 'assignedToUid', 'assignedToName', 'status', 'createdBy', 'createdAt']) &&
        data.keys().hasOnly(['id', 'title', 'description', 'assignedToUid', 'assignedToName', 'status', 'createdBy', 'createdAt', 'completedAt']) &&
        data.id == taskId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 300 &&
        data.description is string && data.description.size() >= 0 && data.description.size() <= 2000 &&
        data.assignedToUid is string && data.assignedToUid.size() >= 1 && data.assignedToUid.size() <= 128 &&
        data.assignedToName is string && data.assignedToName.size() >= 1 && data.assignedToName.size() <= 160 &&
        (data.status == 'pending' || data.status == 'completed') &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 160 &&
        data.createdAt is timestamp &&
        (!('completedAt' in data) || data.completedAt == null || data.completedAt is timestamp);
    }

    function isValidSiteVisits(data) {
      return data.keys().hasAll(['visits', 'updatedAt']) &&
        data.keys().hasOnly(['visits', 'updatedAt']) &&
        data.visits is int && data.visits >= 0 && data.visits <= 1000000000 &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // 3. COLLECTION SECURITY RULES
    // =========================================================================

    // Normal Student Users (/students/{studentId})
    match /students/{studentId} {
      allow get: if isSignedIn() && (request.auth.uid == studentId || isOfficialOrAdmin());
      allow list: if isOfficialOrAdmin();
      allow create: if isSignedIn() &&
        isValidId(studentId) &&
        request.auth.uid == studentId &&
        isValidStudentUser(incoming(), studentId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isValidId(studentId) &&
        request.auth.uid == studentId &&
        isValidStudentUser(incoming(), studentId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'yearCourse', 'photoURL', 'updatedAt']);
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == studentId);
    }

    // Provisioned Council Accounts (/councilAccounts/{accountId})
    // Read access is strictly restricted to verified Officials & Admins (NEVER public).
    // Write/role-mutation access is strictly restricted to Web Admins (no self-promotion).
    match /councilAccounts/{accountId} {
      allow get, list: if isOfficialOrAdmin();
      allow create: if isAdmin() &&
        isValidId(accountId) &&
        isValidCouncilAccount(incoming(), accountId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(accountId) &&
        isValidCouncilAccount(incoming(), accountId) &&
        incoming().id == existing().id &&
        incoming().createdByEmail == existing().createdByEmail &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'name', 'position', 'role', 'authUid', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(accountId);
    }

    // Public Council Officers Directory (/councilOfficers/{officerId})
    match /councilOfficers/{officerId} {
      allow get: if existing().visibility == 'public' || isOfficialOrAdmin();
      allow list: if resource.data.visibility == 'public' || isOfficialOrAdmin();
      allow create: if isOfficialOrAdmin() &&
        isValidId(officerId) &&
        isValidCouncilOfficer(incoming(), officerId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isOfficialOrAdmin() &&
        isValidId(officerId) &&
        isValidCouncilOfficer(incoming(), officerId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['term', 'name', 'position', 'committee', 'image', 'optional', 'accountId', 'visibility', 'updatedAt']);
      allow delete: if isOfficialOrAdmin() && isValidId(officerId);
    }

    // Public Announcements (/announcements/{announcementId})
    match /announcements/{announcementId} {
      allow get: if existing().visibility == 'public' || isOfficialOrAdmin();
      allow list: if resource.data.visibility == 'public' || isOfficialOrAdmin();
      allow create: if isOfficialOrAdmin() &&
        isValidId(announcementId) &&
        isValidAnnouncement(incoming(), announcementId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isOfficialOrAdmin() &&
        isValidId(announcementId) &&
        isValidAnnouncement(incoming(), announcementId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'date', 'publishedAt', 'category', 'summary', 'issuedBy', 'image', 'visibility', 'updatedAt']);
      allow delete: if isOfficialOrAdmin() && isValidId(announcementId);
    }

    // Public Upcoming Events (/events/{eventId})
    match /events/{eventId} {
      allow get: if existing().visibility == 'public' || isOfficialOrAdmin();
      allow list: if resource.data.visibility == 'public' || isOfficialOrAdmin();
      allow create: if isOfficialOrAdmin() &&
        isValidId(eventId) &&
        isValidPortalEvent(incoming(), eventId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isOfficialOrAdmin() &&
        isValidId(eventId) &&
        isValidPortalEvent(incoming(), eventId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'date', 'startsAt', 'time', 'location', 'category', 'description', 'image', 'imageAlt', 'visibility', 'updatedAt']);
      allow delete: if isOfficialOrAdmin() && isValidId(eventId);
    }

    // Live Student Forum (/forumThreads/{threadId})
    match /forumThreads/{threadId} {
      allow get: if existing().visibility == 'public' || isOfficialOrAdmin();
      allow list: if resource.data.visibility == 'public' || isOfficialOrAdmin();
      allow create: if isForumParticipant() &&
        isValidId(threadId) &&
        isValidForumThread(incoming(), threadId) &&
        incoming().authorUid == request.auth.uid &&
        incoming().supportCount == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(threadId) &&
        isValidForumThread(incoming(), threadId) &&
        incoming().id == existing().id &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isOfficialOrAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['author', 'yearLevel', 'postedAt', 'topic', 'title', 'body', 'supportCount', 'replies', 'visibility', 'updatedAt'])
          ) ||
          (
            isForumParticipant() &&
            incoming().author == existing().author &&
            incoming().yearLevel == existing().yearLevel &&
            incoming().postedAt == existing().postedAt &&
            incoming().topic == existing().topic &&
            incoming().title == existing().title &&
            incoming().body == existing().body &&
            incoming().visibility == existing().visibility &&
            (
              incoming().supportCount == existing().supportCount ||
              incoming().supportCount == existing().supportCount + 1 ||
              incoming().supportCount == existing().supportCount - 1
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['supportCount', 'replies', 'updatedAt'])
          )
        );
      // Only the thread's original author or a Council Official/Admin moderator can delete a thread.
      allow delete: if isValidId(threadId) && (
        isOfficialOrAdmin() ||
        (isForumParticipant() && existing().authorUid == request.auth.uid)
      );

      // Subcollection: /forumThreads/{threadId}/replies/{replyId}
      match /replies/{replyId} {
        allow get, list: if true;
        allow create: if isForumParticipant() &&
          isValidId(replyId) &&
          isValidForumReply(incoming(), replyId, threadId) &&
          incoming().createdAt == request.time;
        allow delete: if isValidId(replyId) && (
          isOfficialOrAdmin() ||
          (isForumParticipant() && existing().authorUid == request.auth.uid)
        );
      }

      // Subcollection: /forumThreads/{threadId}/supports/{userId} (1 per authenticated UID)
      match /supports/{userId} {
        allow get, list: if isSignedIn();
        allow create: if isForumParticipant() &&
          userId == request.auth.uid &&
          isValidForumSupport(incoming(), userId, threadId) &&
          incoming().createdAt == request.time;
        allow delete: if isForumParticipant() && userId == request.auth.uid;
      }
    }

    // Portal Filter & Branding Settings (/portalSettings/{settingId})
    match /portalSettings/{settingId} {
      allow get: if existing().visibility == 'public' || isOfficialOrAdmin();
      allow list: if resource.data.visibility == 'public' || isOfficialOrAdmin();
      allow create: if isOfficialOrAdmin() &&
        isValidId(settingId) &&
        isValidPortalSettings(incoming(), settingId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isOfficialOrAdmin() &&
        isValidId(settingId) &&
        isValidPortalSettings(incoming(), settingId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['announcementFilters', 'eventFilters', 'forumFilters', 'aiAutoSync', 'customLogoUrl', 'aboutSlacImage', 'visibility', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(settingId);
    }

    // Frequently Asked Questions (/faqs/{faqId})
    match /faqs/{faqId} {
      allow get: if existing().visibility == 'public' || isOfficialOrAdmin();
      allow list: if resource.data.visibility == 'public' || isOfficialOrAdmin();
      allow create: if isOfficialOrAdmin() &&
        isValidId(faqId) &&
        isValidFaqDoc(incoming(), faqId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isOfficialOrAdmin() &&
        isValidId(faqId) &&
        isValidFaqDoc(incoming(), faqId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['category', 'question', 'answer', 'order', 'visibility', 'updatedAt']);
      allow delete: if isOfficialOrAdmin() && isValidId(faqId);
    }

    // SSC Suite Assigned Tasks (/tasks/{taskId})
    match /tasks/{taskId} {
      allow get, list: if isOfficialOrAdmin() && (
        isAdmin() || resource.data.assignedToUid == request.auth.uid
      );
      allow create: if isAdmin() &&
        isValidId(taskId) &&
        isValidCouncilTask(incoming(), taskId) &&
        incoming().createdAt == request.time;
      allow update: if isOfficialOrAdmin() &&
        isValidId(taskId) &&
        isValidCouncilTask(incoming(), taskId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() ||
          (
            existing().assignedToUid == request.auth.uid &&
            incoming().assignedToUid == existing().assignedToUid &&
            incoming().assignedToName == existing().assignedToName &&
            incoming().title == existing().title &&
            incoming().description == existing().description &&
            incoming().createdBy == existing().createdBy &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(taskId);
    }

    // Site Statistics (/siteStats/{statId})
    // Public read; direct client writes require an authenticated user and strictly +1 increment
    // (unauthenticated visits are recorded via /api/stats/visit Cloud Function).
    match /siteStats/{statId} {
      allow get, list: if statId == 'visits';
      allow create: if isSignedIn() &&
        statId == 'visits' &&
        isValidSiteVisits(incoming()) &&
        incoming().visits == 1 &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        statId == 'visits' &&
        isValidSiteVisits(incoming()) &&
        incoming().visits == existing().visits + 1 &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['visits', 'updatedAt']);
      allow delete: if isAdmin() && statId == 'visits';
    }
  }
}
